# Production settings for DigitalOcean App Platform.
# Enter these under App > Settings > Environment Variables (mark secrets as
# "Encrypt"). Copy the secret values from your local .env; never commit them.

NODE_ENV=production
# App Platform sets PORT itself; leave it out or set it to the app's HTTP port (8080).
PORT=8080

# Browser sites allowed to call this API, comma-separated, no trailing slash.
# The phone app (APK) sends no Origin header, so it never needs to be listed.
ALLOWED_ORIGINS=https://multigym-next.vercel.app

MONGO_URI=
JWT_SECRET=
CRON_SECRET=

AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM_NAME=
IMAP_HOST=
IMAP_PORT=
IMAP_SECURE=
POP3_HOST=
POP3_PORT=
POP3_SECURE=
